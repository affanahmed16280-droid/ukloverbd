rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function validOrderItem(item) {
      return item.keys().hasOnly(['id', 'name', 'brand', 'price', 'quantity', 'image'])
        && item.id is string
        && item.name is string
        && item.brand is string
        && item.price is number
        && item.price >= 0
        && item.quantity is int
        && item.quantity > 0
        && item.image is string;
    }

    function validOrder() {
      return request.resource.data.keys().hasOnly([
          'name', 'phone', 'address', 'notes', 'items', 'total', 'createdAt', 'status'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 20
        && request.resource.data.address is string
        && request.resource.data.address.size() >= 10
        && request.resource.data.address.size() <= 500
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 1000
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.items[0] is map
        && validOrderItem(request.resource.data.items[0])
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if validOrder();
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
